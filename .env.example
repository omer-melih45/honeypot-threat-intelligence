# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key - LLM for the AI threat reports (05_ai_agent.py, 06_executive_reporter.py)
GROQ_API_KEY=

# AbuseIPDB API key - IP reputation lookups (05_ai_agent.py, 10_risk_scoring.py)
ABUSEIPDB_API_KEY=

# VirusTotal API key - payload hash lookups (05_ai_agent.py, 10_risk_scoring.py)
VT_API_KEY=

# Elasticsearch URL - data extraction (01_data_extraction.py) and the live status badge
# Default when empty: http://localhost:9200 | inside Docker, for an ES on the host: http://host.docker.internal:9200
ES_HOST=

# Elasticsearch index pattern holding T-Pot events (default when empty: logstash-*)
ES_INDEX=

# Optional Elasticsearch basic-auth credentials (01 + status badge; leave empty if ES has no auth)
ES_USER=
ES_PASSWORD=

# Name filter for T-Pot Docker containers in the status badge (default: tpot)
TPOT_NAME_FILTER=
